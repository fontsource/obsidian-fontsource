{
	"name": "obsidian-fontsource-plugin",
	"version": "1.0.0",
	"description": "This is a plugin to load custom fonts from Fontsource in Obsidian.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@11.15.0",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "node --test --experimental-strip-types src/*.test.ts",
		"check": "pnpm lint && pnpm test && pnpm build",
		"sync:release-metadata": "node version-bump.mjs --allow-existing",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"fontsource",
		"fonts"
	],
	"author": "Ayuhito",
	"license": "MIT",
	"homepage": "https://github.com/fontsource/obsidian-fontsource#readme",
	"bugs": {
		"url": "https://github.com/fontsource/obsidian-fontsource/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fontsource/obsidian-fontsource.git"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@eslint/json": "0.14.0",
		"@types/node": "^24.13.3",
		"esbuild": "0.28.1",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^17.7.0",
		"obsidian": "^1.13.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.64.0"
	},
	"dependencies": {
		"@fontsource-utils/generate": "^0.4.2",
		"lfi": "4.1.2",
		"limit-concur": "^4.0.0"
	}
}
